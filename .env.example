# foreman runner configuration (docker-compose.yml).
#
# Every variable the containers read is listed here, with no real values.
# Copy this file to .env next to docker-compose.yml and fill it in. Nothing
# host-specific is baked into the image: hostnames, credentials and the
# docker group id all come from here.
#
# Required: one Claude credential (ANTHROPIC_API_KEY, or CLAUDE_CODE_OAUTH_TOKEN
# for subscription auth) and GH_TOKEN, so runs can push and open pull
# requests. Everything else is optional; each daemon logs one line per
# integration at startup saying whether it is on.
#
# Optional: secrets/global.env, written by a secret store if you run one,
# is read after this file, so a value set in both wins from there. Without it
# nothing changes. No systemd, cron or Proxmox is needed: scripts/deploy.sh
# skips the cron entries on a host without crontab and the Claude rules mirror
# on a host without ~/.claude.
#
# docker-compose.yml sets WORK_WORKSPACE_ROOT=/app/workspace itself, because
# it has to match the container's mount. Do not set it here; move the host
# side with FOREMAN_WORKSPACE_DIR instead.

# --- Build ------------------------------------------------------------------

# Optional. gid of the host's `docker` group (`getent group docker | cut -d: -f3`). The
# container user joins a group with this gid so it can use the mounted
# /var/run/docker.sock. Read at build time: rebuild after changing it.
DOCKER_GID=991

# --- Where things are -------------------------------------------------------

# Optional. pinboard's API base URL, without /api. Default http://pinboard:8095.
PINBOARD_URL=http://pinboard:8095

# Optional. Host path of the workspace clone (<org>/<repo> directories, what a
# pinboard project's localPath is relative to). Default ./workspace.
# FOREMAN_WORKSPACE_DIR=

# Optional. Where the operator's workspace-wide repos live inside the
# container: homelab/AGENTS.md (conventions every run reads first) and
# homelab/scripts/deploy-service.sh (post-merge deploys). Default: the one
# directory under /app/workspace that holds a `homelab` checkout (the first by
# name if several do). Without them runs skip the conventions file and a merged
# task is left for a manual deploy. A repo whose clone there has a keyring.json
# at its root is treated as the secret store: it deploys first and the hosts
# its change affects are synced before anything else deploys.
# WORK_HOMELAB_ROOT=

# Optional. Per-task agent workdirs. Mounted at this SAME path inside the container, so
# bind mounts an agent's own `docker compose run` asks the host daemon for
# resolve to the same files. Default /app/tasks.
WORK_TASK_ROOT=/app/tasks

# Optional. SSH user on the service hosts, for deploys and healthchecks
# (deploy-service.sh, the pipeline's verifying stage). Default marek.
HOMELAB_USER=

# --- Credentials (never in anything committed) -------------------------------

# Required. GitHub token for gh and for git over https (a credential helper in
# the image hands it to git). Needs repo + workflow scope on every repo foreman
# works in.
GH_TOKEN=

# Required: one of these two. Used by every run whose pinboard license names no
# token variable of its own (a single-seat install). An API key wins if both
# are set. CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token`.
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional, multi-seat. Each pinboard License can name the variable holding its
# own OAuth token (License.tokenEnvVar); a run on that seat gets that value as
# CLAUDE_CODE_OAUTH_TOKEN, never the install-wide credential above, and the
# raw CLAUDE_OAUTH_TOKEN* variables are stripped from what agents see. Add one
# variable per seat, named as its license says.
# CLAUDE_OAUTH_TOKEN=
# CLAUDE_OAUTH_TOKEN_PETER=

# Optional. Shared local inference gateway, for agents whose executor is
# "8ball". Without them such tasks fail with a clear "not configured" error.
EIGHT_BALL_URL=
EIGHT_BALL_API_KEY=
# Optional. pinboard project slug a gateway outage alert is filed under.
# Empty files it under no project.
# EIGHT_BALL_PROJECT=

# --- Optional ---------------------------------------------------------------

# Model and effort for claude spawns (app/src/agent-settings.ts). Defaults:
# claude-opus-5-5, medium.
# CLAUDE_MODEL=
# CLAUDE_EFFORT=
